{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "n4.gg • Docs",
  "colors": {
    "primary": "#014188",
    "light": "#00feff",
    "dark": "#014188"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "asset-escrow",
              "support-and-policies",
              "faq",
              "common-issues"
            ]
          },
          {
            "group": "Queue",
            "pages": [
              "queue/introduction",
              "queue/installation",
              "queue/configuration",
              "queue/commands",
              "queue/events",
              "queue/exports"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Store",
          "href": "https://store.n4.gg",
          "icon": "cart-shopping"
        },
        {
          "anchor": "Support",
          "href": "https://n4.gg/support",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/n4",
          "icon": "discord"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Email support",
        "href": "mailto:support@n4.gg"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Website",
      "href": "https://n4.gg"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/n4",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
